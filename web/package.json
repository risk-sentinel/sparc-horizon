{
  "name": "sparc-horizon-hud",
  "version": "0.0.0",
  "private": true,
  "description": "The Horizon HUD: API v0 drawn as a heatmap. No runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/model.ts --test-coverage-include=src/api.ts --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 src/*.test.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5"
  }
}
